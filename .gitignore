Intermediate/
Saved/
DerivedDataCache/
/Content/Developers/
/Content/Collections/

# Marketplace (Fab) assets - not redistributed in this public repository.
# Their licenses do not allow redistribution, and they exceed the GitHub LFS
# quota (about 1.4 GB). Add them from Fab yourself; see README.md.
# Only the project levels in Content/DynamicMeshCreator/Map/ are tracked
# (Main = default map with the crack decals, ChineseCity = its sublevel).
/Content/DynamicMeshCreator/*
!/Content/DynamicMeshCreator/Map/
/Content/DynamicMeshCreator/Map/*
!/Content/DynamicMeshCreator/Map/Main.umap
!/Content/DynamicMeshCreator/Map/Main_BuiltData.uasset
!/Content/DynamicMeshCreator/Map/ChineseCity.umap
!/Content/DynamicMeshCreator/Map/ChineseCity_BuiltData.uasset
/Content/Fab/

